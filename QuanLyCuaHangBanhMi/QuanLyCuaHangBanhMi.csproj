<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\FormLogin.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormLogin.Designer.cs">
      <DependentUpon>FormLogin.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\FormLogin.resx">
      <DependentUpon>FormLogin.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\AccountManagementControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\AccountManagementControl.Designer.cs">
      <DependentUpon>AccountManagementControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\AdministrationControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\AdministrationControl.Designer.cs">
      <DependentUpon>AdministrationControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\RoleManagementControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\RoleManagementControl.Designer.cs">
      <DependentUpon>RoleManagementControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\BranchManagementControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\BranchManagementControl.Designer.cs">
      <DependentUpon>BranchManagementControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\ShiftManagementControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\ShiftManagementControl.Designer.cs">
      <DependentUpon>ShiftManagementControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\EmployeeShiftScheduleControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\EmployeeShiftScheduleControl.Designer.cs">
      <DependentUpon>EmployeeShiftScheduleControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\AdministrationDashboardControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\AdministrationDashboardControl.Designer.cs">
      <DependentUpon>AdministrationDashboardControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\Administration\UserManagementView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\Administration\UserManagementView.Designer.cs">
      <DependentUpon>UserManagementView.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
